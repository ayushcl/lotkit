LOTKIT_ENV=development
LOTKIT_DATA_DIR=
# Explicit values override Render's official external URL/hostname fallbacks.
LOTKIT_PUBLIC_BASE_URL=http://127.0.0.1:8000
LOTKIT_TRUSTED_HOSTS=localhost,127.0.0.1
LOTKIT_FORWARDED_ALLOW_IPS=127.0.0.1
LOTKIT_DOCS_ENABLED=true
PORT=8000

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
